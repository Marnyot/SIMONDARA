PORT=8080
NODE_ENV=development
# Optional: true/false. Unset defaults to true in production, false otherwise.
# TRUST_PROXY=true
# Production: mqtts://<cluster>.hivemq.cloud:8883
MQTT_URL=mqtt://localhost:1883
# Local development credentials only. Use distinct strong credentials in production.
MQTT_USERNAME=backend
MQTT_PASSWORD=dev
DEVICE_ID=kos-01
DB_PATH=./data/simondara.db
# Generate with npm run hash-password. Format: scrypt$<32 hex salt>$<128 hex key>
ADMIN_PASSWORD_HASH=
# At least 32 random characters (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# Production: exact Vercel origin (POST Origin check), not the Railway backend URL.
WEB_ORIGIN=http://localhost:5173
# Empty token disables Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Simulator uses separate device credentials, never the backend credentials.
SIM_MQTT_USERNAME=device
SIM_MQTT_PASSWORD=dev
SIM_SCENARIO=normal
